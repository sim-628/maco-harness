{
  "name": "maco-harness",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "check": "npm test && npm run test:worker && npm run check:worker",
    "check:worker": "wrangler deploy --dry-run",
    "test:worker": "node --test test/worker.integration.mjs"
  },
  "devDependencies": {
    "wrangler": "4.164.0",
    "miniflare": "5.20261117.0-beta"
  }
}
